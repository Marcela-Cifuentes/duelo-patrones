{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".write": "auth != null && (data.exists() ? data.child('hostUid').val() === auth.uid : newData.child('hostUid').val() === auth.uid)",
        "state":  { ".read": "auth != null" },
        "cur":    { ".read": "auth != null" },
        "pairs":  {
          ".read": "auth != null",
          "$pid": {
            ".write": "auth != null && auth.uid === $pid",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 40"
          }
        },
        "res":    { ".read": "auth != null" },
        "scores": { ".read": "auth != null" },
        "answers": {
          ".read": "auth != null && root.child('rooms').child($room).child('hostUid').val() === auth.uid",
          "$r": { "$pid": { "$k": { ".write": "auth != null && auth.uid === $pid && !data.exists()" } } }
        }
      }
    }
  }
}
